---
interface Props {
    name: string;
    title: string;
    skills: string[];
    email: string;
    linkedin: string;
    github: string;
    location: string;
}

const { name, title, skills, email, linkedin, github, location } = Astro.props;
---

<div class="bg-gradient-to-r from-zinc-900 to-stone-200 text-white py-16 px-8 rounded-lg shadow-lg">
    <h1 class="text-4xl font-bold mb-4">{name}</h1>
    <p class="text-xl mb-6">{title}</p>

    <div class="mb-6">
        <h2 class="text-lg font-semibold mb-2">Skills:</h2>
        <div class="flex flex-wrap gap-2">
            {skills.map((skill) => (
                <span class="bg-white/20 px-3 py-1 rounded-full text-sm">{skill}</span>
            ))}
        </div>
    </div>

    <div class="flex flex-wrap gap-4 text-sm">
        <a href={`mailto:${email}`} class="hover:underline">{email}</a>
        <a href={linkedin} target="_blank" class="hover:underline">LinkedIn</a>
        <a href={github} target="_blank" class="hover:underline">GitHub</a>
        <span>{location}</span>
    </div>
</div>